  <subsection xml:id="subsec-Linear-algebra-review">
    <title>Linear Algebra Review</title>

    <definition xml:id="def-matrices-and-things">
      <statement>
        <p>
          <dl>
            <li>
              <title>Matrix</title>
              <p>
                For positive integers <m>m</m> and <m>n</m>, a matrix <m>A \in M_{m\times n}(\R)</m> is an array of real numbers with <m>m</m> rows and <m>n</m> columns.
                The entry <m>a_{ij}</m> refers to the entry in the <m>i</m>-th row and <m>j</m>-th column.
                A matrix is said to be <term>square</term> when <m>m = n</m>.
              </p>
            </li>
            <li><title>Matrix Algebra</title>
              <p>
                <term>addition</term>, etc, multiplication
              </p>
            </li>
            <li><title>Matrix Equation for a Linear System</title>
            <p>
              <m>Ax = b</m>, <term>homogeneous</term>
            </p>
            </li>
            <li><title>Augmented Matrix</title>
            <p>Represents a linear system</p>
            </li>
            <li>
              <title>Determinant</title>
            </li>
          </dl>
        </p>
      </statement>
    </definition>

