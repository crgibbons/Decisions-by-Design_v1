<table>
 <title>Cutoff points for Huntington-Hill rounding of quotas between 1 and 10</title>
 <tabular>
  <row><cell>Quota is between</cell><cell>Cutoff point</cell></row>
  <row><cell>1 and 2</cell><cell><m>\sqrt{2} \approx 1.414</m></cell></row>
  <row><cell>2 and 3</cell><cell><m>\sqrt{6} \approx 2.449</m></cell></row>
  <row><cell>3 and 4</cell><cell><m>\sqrt{12} \approx 3.464</m></cell></row>
  <row><cell>4 and 5</cell><cell><m>\sqrt{20} \approx 4.472</m></cell></row>
  <row><cell>5 and 6</cell><cell><m>\sqrt{30} \approx 5.477</m></cell></row>
  <row><cell>6 and 7</cell><cell><m>\sqrt{42} \approx 6.481</m></cell></row>
  <row><cell>7 and 8</cell><cell><m>\sqrt{56} \approx 7.483</m></cell></row>
  <row><cell>8 and 9</cell><cell><m>\sqrt{72} \approx 8.485</m></cell></row>
  <row><cell>9 and 10</cell><cell><m>\sqrt{90} \approx 9.487</m></cell></row>
</tabular>
</table>

