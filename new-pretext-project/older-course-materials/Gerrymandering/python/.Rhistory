st_as_sf() %>%
select(congress, district, label_pt) %>%
st_set_geometry("label_pt")
# --- Map 1: single Congress (example: 119th) -----------------------------
ggplot(filter(va_both, congress == "119th")) +
geom_sf(aes(fill = district), color = "white", linewidth = 0.3, show.legend = FALSE) +
geom_sf_text(data = filter(labels, congress == "119th"),
aes(label = district), size = 3, color = "black") +
coord_sf(datum = NA) +
labs(title = "Virginia Congressional Districts (119th Congress)") +
theme_minimal()
# --- Map 2: side-by-side 118th vs 119th ---------------------------------
ggplot(va_both) +
geom_sf(aes(fill = district), color = "white", linewidth = 0.25, show.legend = FALSE) +
geom_sf_text(data = labels, aes(label = district), size = 2.7, color = "black") +
facet_wrap(~ congress, ncol = 2) +
coord_sf(datum = NA) +
labs(title = "Virginia Congressional Districts: 118th vs 119th") +
theme_minimal()
# install.packages(c("sf","dplyr","stringr","tigris","ggplot2","ggrepel"))
library(sf)
library(dplyr)
library(stringr)
library(tigris)
library(ggplot2)
library(ggrepel)
options(tigris_use_cache = TRUE)
get_va_cd <- function(year, congress_label) {
cd <- tigris::congressional_districts(state = "VA", year = year, cb = FALSE)
cd_field <- names(cd)[grepl("^CD\\d+FP$", names(cd))]
if (length(cd_field) == 0) stop("No CDxxFP field found in data.")
cd_field <- cd_field[1]
cd %>%
mutate(
cd = .data[[cd_field]],
district = paste0("VA-", str_pad(as.character(cd), 2, pad = "0")),
congress = congress_label
)
}
plot_cd_map <- function(sfobj, title) {
# project just for nicer label placement
x <- st_transform(sfobj, 3857)
# label points that stay inside polygons
pts <- x %>%
mutate(pt = st_point_on_surface(geometry)) %>%
st_as_sf() %>%
select(district, pt) %>%
st_set_geometry("pt")
# coordinates for ggrepel
xy <- st_coordinates(pts)
ggplot() +
geom_sf(data = x, fill = "grey92", color = "grey25", linewidth = 0.6) +
geom_label_repel(
data = cbind(pts, xy),
aes(X, Y, label = district),
size = 3.2,
label.size = 0.15,
point.padding = 0.2,
box.padding = 0.25,
min.segment.length = 0
) +
coord_sf(datum = NA) +
labs(title = title) +
theme_minimal(base_size = 13) +
theme(
panel.grid.major = element_line(linewidth = 0.15),
plot.title = element_text(face = "bold")
)
}
# 118th ~ year 2023 ; 119th ~ year 2024 (tigris convention)
va_118 <- get_va_cd(2023, "118th")
va_119 <- get_va_cd(2024, "119th")
p118 <- plot_cd_map(va_118, "Virginia Congressional Districts (118th Congress)")
p119 <- plot_cd_map(va_119, "Virginia Congressional Districts (119th Congress)")
p118
p119
# Optional: save bigger, high-res images
ggsave("va_cd118_map.png", p118, width = 10, height = 7.5, dpi = 300)
ggsave("va_cd119_map.png", p119, width = 10, height = 7.5, dpi = 300)
# install.packages(c("sf","dplyr","stringr","tigris","ggplot2","lwgeom"))
library(sf)
library(dplyr)
library(stringr)
library(tigris)
library(ggplot2)
library(lwgeom)
options(tigris_use_cache = TRUE)
# --- 1) Fetch VA districts (119th) ---
# tigris convention: 119th -> year 2024
va <- tigris::congressional_districts(state = "VA", year = 2024, cb = FALSE)
cd_field <- names(va)[grepl("^CD\\d+FP$", names(va))]
if (length(cd_field) == 0) stop("No CDxxFP field found in data.")
cd_field <- cd_field[1]
va <- va %>%
mutate(district = paste0("VA-", str_pad(as.character(.data[[cd_field]]), 2, pad = "0")))
# --- 2) Project to a Virginia-friendly planar CRS (meters) ---
# NAD83 / Virginia Lambert (good statewide); circles will be circles here.
va_m <- st_transform(va, 3968)
# --- 3) Compute (planar) perimeter + area, then equal-perimeter circle ---
va_m <- va_m %>%
mutate(
P = as.numeric(st_length(st_boundary(geometry))), # meters
A = as.numeric(st_area(geometry)),                # m^2
r = P / (2 * pi),                                 # meters
PP = (4 * pi * A) / (P^2)                          # Polsby–Popper
)
# Center circle at an interior point to avoid centroid weirdness
centers <- st_point_on_surface(va_m) %>% st_geometry()
circles <- st_as_sf(
data.frame(district = va_m$district, PP = va_m$PP),
geometry = st_buffer(centers, dist = va_m$r),
crs = st_crs(va_m)
)
# --- 4) Plot: district over its equal-perimeter circle ---
ggplot() +
geom_sf(data = circles, fill = NA, linewidth = 0.6) +
geom_sf(data = va_m, aes(group = district), alpha = 0.45, linewidth = 0.25) +
facet_wrap(~ district, ncol = 4) +
coord_sf(datum = NA) +
labs(
title = "Virginia CD (119th): each district over its equal-perimeter circle",
subtitle = "Polsby–Popper = (district area) / (equal-perimeter circle area)"
) +
theme_minimal(base_size = 12) +
theme(
panel.grid = element_blank(),
strip.text = element_text(face = "bold"),
axis.text = element_blank(),
axis.title = element_blank(),
axis.ticks = element_blank()
)
# install.packages(c("sf","dplyr","stringr","tigris","ggplot2","lwgeom"))
library(sf)
library(dplyr)
library(stringr)
library(tigris)
library(ggplot2)
library(lwgeom)
options(tigris_use_cache = TRUE)
# --- 1) Fetch VA districts (119th Congress) ---
# tigris convention: 119th -> year 2024
va <- tigris::congressional_districts(state = "VA", year = 2024, cb = FALSE)
cd_field <- names(va)[grepl("^CD\\d+FP$", names(va))]
if (length(cd_field) == 0) stop("No CDxxFP field found in data.")
cd_field <- cd_field[1]
va <- va %>%
mutate(district = paste0("VA-", str_pad(as.character(.data[[cd_field]]), 2, pad = "0")))
# --- 2) Project to meters (so circles are real circles) ---
# NAD83 / Virginia Lambert
va_m <- st_transform(va, 3968)
# --- 3) Perimeter/area + equal-perimeter circle + PP ---
va_m <- va_m %>%
mutate(
P  = as.numeric(st_length(st_boundary(geometry))), # meters
A  = as.numeric(st_area(geometry)),                # m^2
r  = P / (2 * pi),                                 # meters
PP = (4 * pi * A) / (P^2)
)
# interior points for circle centers (more reliable than centroids)
centers <- st_point_on_surface(va_m) %>% st_geometry()
circles <- st_as_sf(
data.frame(district = va_m$district, PP = va_m$PP),
geometry = st_buffer(centers, dist = va_m$r),
crs = st_crs(va_m)
)
# --- 4) Build nicer facet labels with PP ---
labels <- va_m %>%
st_drop_geometry() %>%
transmute(
district,
facet = paste0(district, "  (PP=", formatC(PP, format = "f", digits = 3), ")")
)
va_plot  <- va_m  %>% left_join(labels, by = "district")
circ_plot <- circles %>% left_join(labels, by = "district")
# --- 5) Plot: district over its equal-perimeter circle ---
ggplot() +
# circle: thicker outline for emphasis
geom_sf(data = circ_plot, fill = NA, linewidth = 0.8) +
# district: light fill + darker outline
geom_sf(data = va_plot, alpha = 0.25, linewidth = 0.45) +
facet_wrap(~ facet, ncol = 4) +
coord_sf(datum = NA) +
labs(
title = "Virginia CD (119th): each district over its equal-perimeter circle",
subtitle = "Circle has the same perimeter P as the district.  PP = area(district) / area(circle)."
) +
theme_minimal(base_size = 12) +
theme(
panel.grid = element_blank(),
strip.text = element_text(face = "bold", size = 10),
axis.text = element_blank(),
axis.title = element_blank(),
axis.ticks = element_blank()
)
