import boolmat
from boolmat import BoolMat

### Create a Boolean Matrix from a list
A = BoolMat.fromList([[0,0,1],[1,0,0],[1,1,0]])
B = BoolMat.fromList([[1,0,0],[0,0,1],[1,1,0]])
C = BoolMat.fromList([[1,0,1],[1,0,0],[1,1,1]])
Id = BoolMat.makeId(3) ## ones on diag, zero elsewhere
One = BoolMat.makeOne(3,3) ## all ones
Zero = BoolMat.makeZero(3,3) ## all zeros

### Transposes and Complements

A.getTranspose(), A.getComplement()
A.T
A.C

### Equality

A == A
A == B

### "Inclusion" (entrywise <=)

A <= A
A <= B
A <= C
C <= A 

A <= One
Zero <= A

### Addition, Intersection, Multiplication, Residuals

A + B ## entrywise max (union)
A - B ## entrywise min (intersection)
A*B ## via Boolean dot product

X = B/A ## left residual B:A (largest X where XA < B)
X*A == B ## in this case a solution to XA = B
Y = B//A ## right residual B::A (largest X where AX < B)
A*Y == B ## not a solution to AX = B

A * A
A ** 2

A * A * A
A ** 3

### Check for symmetry, skew symmetry
A.isSym()
A.isSkew()
Id.isSym()
Zero.isSkew()

### Decompose into sum of symmetric and skew symmetric matrices
A.sym() ## the symmetric summand
A.skew() ## the skew symmetric summand
A == A.sym() + A.skew()
A.decomp() ## both summands at once in case you want them

### Here's a lovely mess:
A.sym() ** 3 + (A.sym() ** 2) * A.skew() + A.sym() * A.skew() * A.sym() + A.skew() * (A.sym() ** 2) + A.sym() * (A.skew() ** 2) + A.skew() * A.sym() * A.skew() + (A.skew() ** 2) * A.sym()

A ** 3

### Check row and column consistency

A*One == One
One*A == One

C*One == One
One*C == One

### A Boolean Matrix is Invertible IFF it is orthogonal

A*A.T == Id

