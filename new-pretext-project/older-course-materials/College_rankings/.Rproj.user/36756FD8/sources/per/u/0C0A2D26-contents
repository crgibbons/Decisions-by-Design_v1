def bmatrix(a):
    """Returns a LaTeX bmatrix

    :a: numpy array
    :returns: LaTeX bmatrix as a string
    """
    lines = str(a).replace(',', '')
    lines = str(a).replace('[', '').replace(']', '').splitlines()
    rv = [r'\begin{bmatrix}']
    rv += ['  ' + ' & '.join(l.split()) + '\\' for l in lines]
    rv +=  [r'\end{bmatrix}']
    return ''.join(rv)
  

