# === PCR

require(pls)
set.seed (1000)
pcr_model <- pcr(y~., 
                 data = df, 
                 scale = TRUE, 
                 validation = "CV")
summary(pcr_model)
validationplot(pcr_model)
validationplot(pcr_model, val.type="MSEP")
validationplot(pcr_model, val.type = "R2")
predplot(pcr_model)
coefplot(pcr_model)
pcr_pred <- predict(pcr_model, ncomp = 5)
mean((pcr_pred - y)^2)/var(y)
a = data.frame(round(pcr_pred), y)
