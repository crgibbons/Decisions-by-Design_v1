## Can we back-engineer the weights? Apply Multiple Linear Regression without intercept

```{r}
names(cr)[4] = 'Compensation'
names(cr)[6] = 'Networking'
names(cr)[7] = 'Entrepreneurship'
m <- lm(formula = Overall.score ~ Compensation + Learning + 
                                  Networking + Entrepreneurship + Diversity - 1, data = cr)
df <- as.data.frame(coef(m))
colnames(df) = 'MLR_weights'
df <- df %>% 
  mutate(pr_weights = weights[row.names(df)]) %>% 
  relocate(pr_weights)
round(df, 2)
