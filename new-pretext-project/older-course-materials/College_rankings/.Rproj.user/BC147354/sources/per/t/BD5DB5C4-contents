```

##  Dr. Jain: "a constrained optimization model that minimizes variances from the published ranking"

Model

$$y = w_1x_1 + w_2x_2 + w_3x_3 + w_4x_4 + w_5x_5 + \epsilon$$
with $\sum_i w_i = 1$ and $w_i \geq 0$. Then minimize

$$\sum_i (y_i - (w_1x_1 + w_2x_2 + w_3x_3 + w_4x_4 + w_5x_5))^2$$


##  Back-engineered weights through constrained optimization

```{r}
x1 = cr$Compensation
x2 = cr$Learning
x3 = cr$Networking
x4 = cr$Entrepreneurship
x5 = cr$Diversity
y = cr$Overall.score

library("quadprog")
X <- matrix(c(x1,x2,x3,x4,x5), ncol=5)
Y <- y
Rinv <- solve(chol(t(X) %*% X))
C <- cbind(rep(1,5), diag(5)) # design matrix kind of
b <- c(1,rep(0,5))
d <- t(Y) %*% X  

a = solve.QP(Dmat = Rinv, factorized = TRUE, dvec = d, Amat = C, bvec = b, meq = 1)
df <- data.frame(pr_weights = weights, 
           const_weights = a$solution)
round(df, 2)
```

## LASSO model

```{r}
library(glmnet)
X = as.matrix(cr[, 4:8])
y = cr$Overall.score
lambdas = 10^seq(3, -3, by = -.1)
fit <- glmnet(X, y, alpha = 1, lambda = lambdas) # alpha=1 in lasso
cv_fit <- cv.glmnet(X, y, alpha = 1, lambda = lambdas, intercept = F)
optlambda <- cv_fit$lambda.min
y_predicted <- predict(fit, s = optlambda, newx = X) # newx contanins the matrix of the predicted values

# Sum of Squares Total and Error
sst <- sum(y^2)
sse <- sum((y_predicted - y)^2)

# R squared
rsq <- 1 - sse / sst
cat("R square is ", rsq, '\n')
df2 <- data.frame(lasso_weights = coef(cv_fit)[2:6,1])
df2 <- df2 %>% 
  mutate(pr_weights = weights[row.names(df2)])
round(df2, 2)
```

